# Copie para .env e ajuste. Todas as variáveis usam o prefixo AIS4_.
AIS4_DB_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ais4
AIS4_DB_HOST=localhost
AIS4_DB_PORTA=5432
AIS4_DB_NOME=ais4
# JSON: senha de cada papel <modulo>_app
AIS4_SENHA_APP={"playbooks":"trocar","acervo":"trocar","projetos":"trocar","criacao":"trocar","execucao":"trocar"}
AIS4_ARTEFATOS_DIR=artefatos
AIS4_WORKSPACES_DIR=workspaces
AIS4_USUARIOS_ARQUIVO=config/usuarios.toml

AIS4_MAX_ITERACOES_AUTOCRITICA=3
AIS4_MAX_TENTATIVAS_ETAPA=3
AIS4_PROMOCAO_MIN_PROJETOS=3
AIS4_PROMOCAO_NOTA_MIN=4.0
AIS4_LIMIAR_DUPLICIDADE=0.85
AIS4_ORCAMENTO_PADRAO_USD=50
AIS4_ORCAMENTO_PADRAO_TOKENS=20000000
AIS4_MAX_PROJETOS_EM_EXECUCAO=1

# JSON: modelo e effort por papel; papéis ausentes usam o padrão
AIS4_MODELO_POR_PAPEL={}
AIS4_EFFORT_POR_PAPEL={}
AIS4_EMBEDDING_MODELO=voyage-multilingual-2
AIS4_VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
